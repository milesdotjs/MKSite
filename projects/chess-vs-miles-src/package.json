{
  "name": "chess-vs-miles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Play chess against a bot that plays Miles's openings at roughly Miles's strength, and talks like him.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "book:check": "node scripts/check-book.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
