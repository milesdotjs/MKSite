---
import "../styles/app.css";
import { withBase } from "../lib/base";

interface Props {
  title: string;
  description: string;
  /** Path segment used to mark the current nav link, e.g. "glossary". */
  current?: string;
}

const { title, description, current = "" } = Astro.props;
const nav = [
  { href: "build/", label: "Build one", key: "build" },
  { href: "glossary/", label: "Glossary", key: "glossary" },
  { href: "red-flags/", label: "Red flags", key: "red-flags" },
  { href: "for-developers/", label: "For developers", key: "for-developers" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-MC9KF4ZX');</script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MC9KF4ZX"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={withBase("")}>The Floor</a>
        <nav class="site-nav" aria-label="Site">
          {nav.map((n) => <a href={withBase(n.href)} aria-current={current === n.key ? "page" : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>The Floor. Free, no accounts, no server. Nothing you enter leaves your browser.</span>
        <span>Made by <a href="https://mileskingdev.com">Miles King</a>.</span>
      </div>
    </footer>
  </body>
</html>
